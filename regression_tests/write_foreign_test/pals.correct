          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        RFP:
          rf_frequency:   5.0000E+08             
          voltage:   1.0000E+05             
          phi0:   1.0000E-01             
          zero_phase: ABOVE_TRANSITION
          cavity_type: STANDING_WAVE       

    - rfcavity2: 
