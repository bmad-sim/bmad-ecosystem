          tilt_ref:   1.0000E-01             
          e1:   1.0000E-01             
          e2:   2.0000E-01             
        MagneticMultipoleP:
          Ks0:  -6.5834E-05             
          Kn0:   1.0017E-02             
          Ks1:   5.0000E-04             
        ElectricMultipoleP:
          En0:  -2.0000E+03             
