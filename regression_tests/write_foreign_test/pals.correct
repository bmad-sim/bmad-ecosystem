          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        RFP:
          rf_frequency:   5.0000E+08             
          voltage:   5.0000E+00             
          phi0:  -1.9000E-01             
          num_cells:   1.0000E+01             
          L_active:   4.4969E+00             
