PALS:
  notes:
    - "Translated from Bmad lattice file: write_foreign_test.bmad"

  extension_labels:
    names:
      Bmad: Bmad specific data
    prefixes:
      Bmad_: Bmad specific data


  #---------------------------------------------------------------------------------------
  facility:

    #---------------------------------------------------------------------------------------
    # Constants

    #---------------------------------------------------------------------------------------
    # Lattice Elements

    - beginning_b1: 
        kind: BeginningEle
        ReferenceP:
          pc_ref:   8.5958E+05             
          species_ref: "positron"
        TwissP:
          beta_a:   1.0000E+01             
          beta_b:   1.0000E+01             
        ParticleP:
          x:   1.0000E-03             
          px:   2.0000E-03             
          y:   3.0000E-03             
          py:   4.0000E-03             
          z:   5.0000E-03             
          pz:   6.0000E-03             
          spin_x:   3.0000E-01             
          spin_y:   4.0000E-01             
          spin_z:   5.0000E-01             
        Bmad:
          Bmad_key: Beginning_Ele

    - ab_multipole1: 
        kind: Multipole
        MagneticMultipoleP:
          Ks2L:   2.0000E+02             
          Kn2L:   2.0000E+02             
        Bmad:
          Bmad_key: AB_multipole

    - ac_kicker0123456789: 
        kind: ACKicker
        length:   3.0000E-01             
        MagneticMultipoleP:
          Kn0:  -3.3333E-02             
        Bmad:
          Bmad_key: AC_Kicker

    - ac_kicker2: 
        kind: ACKicker
        length:   4.0000E-01             
        MagneticMultipoleP:
          Ks0:   2.5000E-02             
        Bmad:
          Bmad_key: AC_Kicker

    - beambeam1: 
        kind: BeamBeam
        BodyShiftP:
          x_offset:   3.0000E-03             
          y_offset:   3.0000E-03             
          x_rot:  -5.0000E-02             
        SolenoidP:
          Ksol:   1.0000E+00             

    - crab_cavity1: 
        kind: CrabCavity
        length:   2.0000E-01             
        RFP:
          rf_frequency:   1.0000E+08             
          voltage:   1.0000E+03             
          phi0:  -2.0000E-01             
          zero_phase: ABOVE_TRANSITION
        Bmad:
          Bmad_key: Crab_Cavity

    - ecollimator1: 
        kind: Drift
        length:   4.5000E+00             
        MagneticMultipoleP:
          Ks0:   2.2037E-04             
          Kn0:  -2.2555E-03             
        ApertureP:
          x_min:  -2.0000E-01             
          x_max:   2.0000E-01             
          y_min:  -1.0000E-01             
          y_max:   1.0000E-01             
          shape: ELLIPTICAL      
          location: EXIT_END        
          aperture_shifts_with_body: true
        BodyShiftP:
          x_offset:   2.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        Bmad:
          Bmad_key: ECollimator

    - elseparator1: 
        kind: ELSeparator??
        length:   4.5000E+00             
        ElectricMultipoleP:
          En0:  -1.9102E+02             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        Bmad:
          Bmad_key: ELSeparator

    - elseparator2: 
        kind: ELSeparator??
        length:   4.5000E+00             
        ElectricMultipoleP:
          Es0:   9.5509E+02             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        Bmad:
          Bmad_key: ELSeparator

    - em_field1: 
        kind: EMField
        length:   1.4000E+00             
        RFP:
          zero_phase: ABOVE_TRANSITION
        Bmad:
          Bmad_key: EM_Field

    - em_field2: 
        kind: EMField
        length:   1.4000E+00             
        RFP:
          zero_phase: ABOVE_TRANSITION
        Bmad:
          Bmad_key: EM_Field

    - fiducial1: 
        kind: Fiducial

    - floor_shift1: 
        kind: FloorShift
        BodyShiftP:
          x_offset:   1.0000E-01             
          y_offset:   2.0000E-01             
          z_offset:   3.0000E-01             
          x_rot:  -2.0000E-02             
          y_rot:   1.0000E-02             
          z_rot:   4.0000E-01             
        Bmad:
          Bmad_key: Floor_Shift

    - gkicker1: 
        kind: Kicker
        Bmad:
          Bmad_key: GKicker

    - hkicker1: 
        kind: Kicker
        length:   4.5000E+00             
        MagneticMultipoleP:
          Kn0:  -2.2222E-04             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        Bmad:
          Bmad_key: HKicker

    - instrument1: 
        kind: Instrument
        length:   4.5000E+00             

    - kicker1: 
        kind: Kicker
        length:   4.5000E+00             
        MagneticMultipoleP:
          Ks0:   2.2222E-04             
          Kn0:   4.4444E-07             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             

    - match1: 
        kind: Match

    - monitor1: 
        kind: Instrument
        length:   4.5000E+00             
        Bmad:
          Bmad_key: Monitor

    - multipole1: 
        kind: Multipole
        MagneticMultipoleP:
          Ks1L:  -1.0000E+00             
          Kn1L:   6.1232E-17             
          Ks3L:   3.0805E+00             
          Kn3L:  -3.2804E+00             

    - octupole1: 
        kind: Octupole
        length:   4.5000E+00             
        MagneticMultipoleP:
          Kn3:   1.0000E+03             
        BodyShiftP:
          x_offset:   1.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   3.9270E-01             

    - patch1: 
        kind: Patch
        length:   4.0050E-03             
        PatchP:
          x_offset:   1.0000E-03             
          y_offset:   2.0000E-03             
          z_offset:   4.0000E-03             
          x_rot:  -2.0000E-03             
          y_rot:   1.0000E-03             
          z_rot:   2.0000E+00             
        ReferenceChangeP:
          t_offset:   1.0000E-11             

    - quadrupole1: 
        kind: Quadrupole
        length:   6.0000E-01             
        MagneticMultipoleP:
          Ks0:   1.2357E-02             
          Kn0:  -1.1785E-02             
          Ks1:   1.0000E-01             
          Kn1:   1.0000E+00             
        ElectricMultipoleP:
          En0:  -2.0000E+03             
          Es1:   2.0000E+04             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   7.8540E-01             

    - quadrupole2: 
        kind: Quadrupole
        length:   6.0000E-01             
        MagneticMultipoleP:
          Ks0:  -1.0118E-02             
          Kn0:   1.1785E-04             
          Ks1:  -1.0000E-01             
          Kn1:  -1.0000E+00             
        ElectricMultipoleP:
