        MagneticMultipoleP:
          Kn2:   1.0000E+00             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   5.2360E-01             

    - solenoid1: 
        kind: Solenoid
        length:   2.6000E+00             
        BodyShiftP:
          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        SolenoidP:
          Ksol:   1.0000E+00             

