          tilt_ref:   1.0000E-01             
          e1_rect:   1.0000E-01             
          e2_rect:   2.0000E-01             
        MagneticMultipoleP:
          Ks0:  -1.6583E-04             
          Kn0:   1.6739E-05             
          Ks1:   5.0000E-09             
        ElectricMultipoleP:
          En0:  -2.0000E+03             
          Es1:   6.6667E+03             
        BodyShiftP:
          x_offset:   5.0000E-02             
