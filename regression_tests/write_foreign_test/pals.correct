          x_offset:   5.0000E-02             
          x_rot:  -1.0000E-03             
          z_rot:   1.0000E-01             
        RFP:
          rf_frequency:   5.0000E+08             
          voltage:   5.0450E+03             
          phi0:  -1.9000E-01             
          num_cells:   1.0000E+01             
          L_active:   4.4969E+00             
          cavity_type: TRAVELING_WAVE      
        Bmad:
          Bmad_key: Lcavity

    - end_b0: 
        kind: Marker

    #---------------------------------------------------------------------------------------
    # BeamLines and Lattices

    - l1: 
        kind: BeamLine
        line: [ beginning_b1, ab_multipole1, ac_kicker0123456789, ac_kicker0123456789, ac_kicker2,
               beambeam1, crab_cavity1, ecollimator1, elseparator1, elseparator2, em_field1, em_field2,
               fiducial1, floor_shift1, gkicker1, hkicker1, instrument1, kicker1, match1, monitor1,
               multipole1, octupole1, patch1, quadrupole1, quadrupole2, quadrupole3, quadrupole4,
               quadrupole5, rcollimator1, rfcavity1, rfcavity2, rfcavity3, sad_mult1, sad_mult2,
               sbend1, rbend2, sbend3, rbend4, sbend5, rbend6, sbend7, sextupole1, solenoid1, solenoid2,
               sol_quad1, sol_quad2, thick_multipole1, taylor1, vkicker1, lcavity1, lcavity2, lcavity3,
               end_b0,]

    - machine: 
        kind: Lattice
        branches: 
          - l1: 
              periodic: false

    #---------------------------------------------------------------------------------------
    # Lord elements


    - ov_kick: 
        kind: Controller
        control_type: ABSOLUTE
        variables:
          xk:   1.0000E-03             
        controls:
          - parameter: quadrupole1>MagneticMultipoleP.Kn0
            expression:  -1.1785E+00              * (2*xk)
          - parameter: quadrupole1>MagneticMultipoleP.Ks0
            expression:  -1.1785E+00              * (2*xk) +   1.0000E-02
          - parameter: sbend1>MagneticMultipoleP.Kn0
            expression:  -1.6583E+00              * (xk) +   1.6639E-05
          - parameter: sbend1>MagneticMultipoleP.Ks0
            expression:  -1.6639E-01              * (xk) +  -1.6583E-04
          - parameter: hkicker1>MagneticMultipoleP.Kn0
            expression:  -2.2222E-01              * (xk)
          - parameter: kicker1>MagneticMultipoleP.Ks0
            expression:   2.2222E-01              * (xk)
          - parameter: elseparator1>ElectricMultipoleP.En0
            expression:  -1.9102E+05              * (xk)

    - ov_kick2: 
        kind: Controller
        control_type: ABSOLUTE
        variables:
          xk2:   2.0000E-03             
        controls:
          - parameter: quadrupole1>MagneticMultipoleP.Kn0
            expression:  -1.1785E+00              * (xk2) +  -1.1785E+00              * (3*xk2)
          - parameter: quadrupole1>MagneticMultipoleP.Ks0
            expression:  -1.1785E+00              * (xk2) +   1.1785E+00              * (3*xk2)
