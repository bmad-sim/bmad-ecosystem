no_digested

parameter[lattice]                = g_2
parameter[particle]               = antimuon
parameter[geometry] = open
parameter[p0c]                    = 3.094353005E9

beginning[beta_a] = 10
beginning[beta_b] = 10

particle_start[px] = 1.5e-3

infa:    drift,  l=2,
         tracking_method = bmad_standard, mat6_calc_method = bmad_standard, ds_step=0.001,
         aperture_at = wall_transition,
         aperture_type = wall3d, 
         wall = { superimpose = .true., thickness = 0.0005,
         section = { type = wall_start, s = 0, v(1) = {0.002, 0.01}},
         section = { type = wall_end,   s = 2, v(1) = {0.001, 0.01}} }

dd: drift, l = 10

ec: ecollimator, px_aperture_width2 = 0.01, px_aperture_center = 0.01, 
                 py_aperture_width2 = 0.015,
                 z_aperture_width2 = 0.2, z_aperture_center = -0.6,
                 pz_aperture_width2 = 0.03, pz_aperture_center = 0.02,
                 x1_limit = 1e-10, x2_limit = 0.02,
                 y_limit = 0.015

rc: rcollimator, px_aperture_width2 = 0.01, px_aperture_center = 0.01,
                 py_aperture_width2 = 0.015,
                 z_aperture_width2 = 0.2, z_aperture_center = -0.6,
                 pz_aperture_width2 = 0.03, pz_aperture_center = 0.02,
                 x1_limit = 1e-10, x2_limit = 0.02,
                 y_limit = 0.015

line1: line=(dd, infa, ec, rc)

!----------------

d1: pipe, l = 10, aperture_at = continuous, x_limit = 0.1
d2: pipe, l = 10, aperture_at = both_ends, x_limit = 0.1
q1: quadrupole, l = 1, superimpose, ref = d1, aperture_at = both_ends, x_limit = 0.01
q2: quadrupole, l = 1, superimpose, ref = d2, aperture_at = both_ends, x_limit = 0.01

line2: line = (d1, d2)
line2[geometry] = open
line2[beta_a] = 10
line2[beta_b] = 10

!---------------- Wall hit in the first Runge-Kutta step. See issue #2141.

d3: pipe, l = 1, aperture_at = continuous, aperture_type = elliptical, x_limit = 0.01, y_limit = 0.01,
        tracking_method = runge_kutta

line3: line = (d3)
line3[geometry] = open
line3[beta_a] = 10
line3[beta_b] = 10

!---------------- Continuous aperture within a superimposed region. See issue #2101.
! The quadrupole splits d4 into three super_slaves. The middle slave has two lords and so
! has aperture_at = lord_defined. The continuous aperture of d4 must still be enforced there.

d4: pipe, l = 1, aperture_at = continuous, aperture_type = elliptical, x_limit = 0.005, y_limit = 0.005,
        tracking_method = runge_kutta
q4: quadrupole, l = 0.9, k1 = 0, superimpose, ref = d4, ref_origin = center, ele_origin = center,
        tracking_method = runge_kutta

line4: line = (d4)
line4[geometry] = open
line4[beta_a] = 10
line4[beta_b] = 10

!---------------- Wall_transition aperture within a superimposed region. See issue #2101.

d5: pipe, l = 1, tracking_method = runge_kutta,
        aperture_at = wall_transition, aperture_type = wall3d,
        wall = { superimpose = .true., thickness = 0.0005,
        section = { type = wall_start, s = 0, v(1) = {0.005, 0.005}},
        section = { type = wall_end,   s = 1, v(1) = {0.005, 0.005}} }
q5: quadrupole, l = 0.9, k1 = 0, superimpose, ref = d5, ref_origin = center, ele_origin = center,
        tracking_method = runge_kutta

line5: line = (d5)
line5[geometry] = open
line5[beta_a] = 10
line5[beta_b] = 10

use, line1, line2, line3, line4, line5
